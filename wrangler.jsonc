{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diet-coach",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI. Flue의 cloudflare/... 모델이 이 바인딩을 쓴다. 로컬 개발에서도 원격 호출이라 무료 한도에서 차감된다.
  "ai": { "binding": "AI" },
  // 배포본 로그 (B10, T8-1). 대시보드 Workers → diet-coach → Observability와 Durable Objects → Observability 탭에서 본다.
  // 무료 플랜 한도는 docs/plan-upgrade.md. 사용자가 적어 전부 남긴다(sampling 1).
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // D1: 한도 보호 카운터·사용자 토큰 해시(B8), 프로필·식단표(T6-2). 테이블은 migrations/.
  // 원격 DB는 B9에서 `wrangler d1 create diet-coach`로 만들었다(APAC). 로컬(vite dev)은 .wrangler/state의 로컬 DB를 쓴다.
  // 테이블을 바꾸면 migrations/에 파일을 덧붙이고 `wrangler d1 migrations apply diet-coach --local`과 `--remote`를 둘 다 한다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diet-coach",
      "database_id": "9205116d-8837-4fa8-a3c8-0277509bd41e",
      "migrations_dir": "migrations"
    }
  ],
  // 화면(React 빌드)을 같은 Worker의 정적 자산으로 내보낸다 (스펙 7.1). 디렉터리는 Cloudflare Vite 플러그인이 정한다.
  // /agents/*, /api/*는 Worker(app.ts)가 먼저 받고, 나머지 경로는 SPA(index.html)로 보낸다.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  // 에이전트를 추가할 때마다 마이그레이션을 뒤에 덧붙인다. 배포한 항목은 고치지 않는다.
  "migrations": [
    { "tag": "flue-class-FlueDietCoachAgent", "new_sqlite_classes": ["FlueDietCoachAgent"] }
  ]
}
