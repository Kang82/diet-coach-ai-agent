{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diet-coach",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI. Flue의 cloudflare/... 모델이 이 바인딩을 쓴다. 로컬 개발에서도 원격 호출이라 무료 한도에서 차감된다.
  "ai": { "binding": "AI" },
  // 화면(React 빌드)을 같은 Worker의 정적 자산으로 내보낸다 (스펙 7.1). 디렉터리는 Cloudflare Vite 플러그인이 정한다.
  // /agents/*, /api/*는 Worker(app.ts)가 먼저 받고, 나머지 경로는 SPA(index.html)로 보낸다.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  // 에이전트를 추가할 때마다 마이그레이션을 뒤에 덧붙인다. 배포한 항목은 고치지 않는다.
  "migrations": [
    { "tag": "flue-class-FlueDietCoachAgent", "new_sqlite_classes": ["FlueDietCoachAgent"] }
  ]
}
