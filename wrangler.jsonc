{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diet-coach",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers AI. Flue의 cloudflare/... 모델이 이 바인딩을 쓴다. 로컬 개발에서도 원격 호출이라 무료 한도에서 차감된다.
  "ai": { "binding": "AI" },
  // 에이전트를 추가할 때마다 마이그레이션을 뒤에 덧붙인다. 배포한 항목은 고치지 않는다.
  "migrations": [
    { "tag": "flue-class-FlueDietCoachAgent", "new_sqlite_classes": ["FlueDietCoachAgent"] }
  ]
}
