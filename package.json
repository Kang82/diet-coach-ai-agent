{
  "name": "diet-coach",
  "version": "1.0.0",
  "description": "식단 코치 에이전트 (Flue + Cloudflare)",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "evals": "vitest run --config vitest.evals.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply diet-coach --local",
    "issue-token": "node scripts/issue-token.mjs",
    "issue-invite": "node scripts/issue-invite.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@flue/react": "^2.3.0",
    "@flue/runtime": "^2.3.0",
    "@flue/sdk": "^2.3.0",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@flue/vite": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "private": true,
  "overrides": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0"
  }
}
